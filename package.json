{
  "name": "n8n-nodes-wasaas",
  "version": "0.1.0",
  "description": "n8n community node for Wasaas (wasaas.org) — send WhatsApp text/media messages, check session status and validate numbers through Wasaas's REST API.",
  "keywords": [
    "n8n-community-node-package",
    "wasaas",
    "whatsapp"
  ],
  "license": "MIT",
  "homepage": "https://wasaas.org",
  "author": {
    "name": "Wasaas",
    "url": "https://wasaas.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moatazkhaled93-prog/n8n-nodes-wasaas.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json --ext .ts,.js",
    "lintfix": "eslint nodes credentials package.json --ext .ts,.js --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WasaasApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Wasaas/Wasaas.node.js",
      "dist/nodes/WasaasTrigger/WasaasTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.10"
  }
}
